# ==============================================================================
# Arquivo de Exemplo de Variáveis de Ambiente da Raiz (TCC Full-Stack)
# ==============================================================================
# Este arquivo serve de referência para a orquestração via Docker Compose na raiz.
# Copie para '.env' na raiz se desejar personalizar o Compose unificado:
#   cp .env.example .env
#
# NOTA: O container do backend consome diretamente as variáveis de 'server/.env'.
# Certifique-se de configurar também:
#   cp server/.env.example server/.env
# ==============================================================================

# Credenciais do Banco de Dados PostgreSQL no Docker Compose
POSTGRES_DB=tcc_db
POSTGRESSQL_USER=tcc_user
POSTGRESSQL_PASSWORD=tcc_pass

# Portas públicas expostas na máquina hospedeira
WEB_PORT=80
SERVER_PORT=8080
DB_PORT=5432
